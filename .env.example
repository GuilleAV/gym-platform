# Copiá este archivo como ".env" (en la raíz del repo) y cambiá los valores.
# ".env" está en .gitignore: NUNCA se sube al repositorio.
#
# Generá contraseñas largas y aleatorias, por ejemplo:
#   openssl rand -base64 32

# Contraseña del usuario root de MySQL de DESARROLLO.
# Solo la usa el contenedor; la aplicación nunca se conecta como root.
MYSQL_ROOT_PASSWORD=cambiar-por-una-clave-larga-y-aleatoria

# Puerto de TU PC donde se publica el MySQL del proyecto (dentro del contenedor es 3306).
# 3307 para no chocar con otro MySQL que ya use el 3306.
MYSQL_PORT=3307
