<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        El "parent" de Spring Boot cumple dos funciones:
        1) Es un BOM (Bill Of Materials): fija versiones compatibles entre sí de cientos de
           librerías (Spring, Testcontainers, driver MySQL, JUnit...). Por eso abajo casi
           ninguna dependencia lleva <version>: la versión la decide este parent.
        2) Trae configuración razonable de plugins (compilador, tests, empaquetado).
        Versión fijada en ADR-0001. Para actualizar: cambiar SOLO este número (vía PR).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.gimnasio</groupId>
    <artifactId>gym-platform-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>gym-platform - Backend</name>
    <description>Sistema integral de gestión de gimnasios (monolito modular, multi-tenant)</description>

    <properties>
        <!-- Spring Boot usa esta propiedad para compilar con "release 25". -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            Imagen de MySQL para los tests de integración (Testcontainers).
            DEBE coincidir con infra/docker-compose.yml: VersionesStackTest lo verifica.
            Siempre una versión exacta, nunca "latest".
        -->
        <mysql.image>mysql:8.4.13</mysql.image>
        <!-- Imagen de Mailpit para los tests de integración. DEBE coincidir con infra/docker-compose.yml. -->
        <mailpit.image>axllent/mailpit:v1.34.0</mailpit.image>

        <!--
            Spring Modulith NO está en el BOM de Spring Boot, por eso fijamos su versión acá.
            La línea 2.1.x es la que se compila contra Spring Boot 4.1 (ver ADR-0001).
            Al subir Spring Boot de versión menor (4.2, ...), revisar la tabla de compatibilidad.
        -->
        <spring-modulith.version>2.2.0</spring-modulith.version>
        <!-- BouncyCastle: Argon2 de Spring Security lo necesita. NO está en el BOM de Boot.
             1.85+ corrige CVEs de 2026; Dependabot avisa las nuevas. -->
        <bouncycastle.version>1.87</bouncycastle.version>
    </properties>

    <!--
        dependencyManagement NO agrega dependencias: solo fija versiones. Importar el BOM de
        Spring Modulith hace que todos sus artefactos (test, core, events...) usen la MISMA
        versión, y abajo los declaramos sin <version>, igual que los de Spring Boot.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Núcleo de Spring Boot. Web, seguridad, JPA, Flyway, etc. se agregan en los
             pasos siguientes, cada uno con sus tests. No se suman dependencias "por las dudas":
             cada librería es superficie de ataque y mantenimiento. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Envío de correo (JavaMailSender). Hoy: avisos de disco. Después: invitaciones, vencimientos. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Web: Spring MVC + Tomcat embebido. Desde Boot 4 el starter se llama "webmvc". -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Spring Security: autenticación, autorización, CSRF, cabeceras de seguridad. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Spring Session JDBC: la sesión HTTP se guarda en la base del gimnasio (ADR-0002 §1). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-jdbc</artifactId>
        </dependency>
        <!-- Implementación de Argon2id que usa Argon2PasswordEncoder. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <!--
            Acceso a datos con JDBC (DataSource + pool HikariCP + JdbcTemplate + transacciones).
            Se elige JDBC y no JPA para el catálogo: son pocas tablas, consultas simples y
            queremos ver el SQL. JPA se evalúa para los módulos de negocio más adelante.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Flyway: versiona el esquema de la base con scripts V1, V2... (nunca se editan los aplicados). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Soporte específico de MySQL para Flyway (desde Flyway 10 viene en un módulo aparte). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!-- Driver JDBC de MySQL. "runtime": el código no lo importa directamente, solo lo usa JDBC. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Caffeine: caché en memoria con expiración. La usamos para cerrar los pools de conexiones
             de los gimnasios que no se usan hace 30 minutos (ADR-0002 §4). Versión: BOM de Boot. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- ===================== Tests ===================== -->
        <!-- JUnit Jupiter, AssertJ, Mockito y soporte de tests de Spring. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockMvc para tests de API sin levantar un servidor (en Boot 4 es un módulo aparte). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Spring Modulith (solo tests por ahora): verifica que cada módulo de negocio
            (paquete directo bajo com.gimnasio) no use clases internas de otro ni forme ciclos.
            Ver ModularidadTest. Trae ArchUnit por debajo.
        -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: levanta un MySQL REAL en Docker durante los tests (nunca H2). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Maven Enforcer: hace FALLAR el build si el entorno no cumple ADR-0001.
                Mejor enterarse en el primer "mvn verify" que con un error raro en producción.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-stack</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <!-- [25,26) = "25 o mayor, pero menor que 26": solo Java 25. -->
                                    <version>[25,26)</version>
                                    <message>Este proyecto requiere JDK 25 LTS (ver docs/adr/0001-stack-y-versiones.md).</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.9,4)</version>
                                    <message>Usá Maven 3.9.9+ (idealmente ./mvnw, que fija la versión).</message>
                                </requireMavenVersion>
                                <!-- Evita declarar dos veces la misma dependencia con versiones distintas. -->
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire: tests UNITARIOS (*Test.java). Rápidos, sin Docker. Corren en "mvn test". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Consola en UTF-8: sin esto, Windows muestra "mßs" en vez de "más". -->
                    <argLine>-Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                    <systemPropertyVariables>
                        <mysql.image>${mysql.image}</mysql.image>
                        <mailpit.image>${mailpit.image}</mailpit.image>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Failsafe: tests de INTEGRACIÓN (*IT.java). Usan Docker. Corren en "mvn verify". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Consola en UTF-8: sin esto, Windows muestra "mßs" en vez de "más". -->
                    <argLine>-Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                    <systemPropertyVariables>
                        <mysql.image>${mysql.image}</mysql.image>
                        <mailpit.image>${mailpit.image}</mailpit.image>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Empaqueta la app como un .jar ejecutable. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
